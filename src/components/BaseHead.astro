---
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import newsreaderWoff2 from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import { getImage } from 'astro:assets';
import siteConfig from '../data/site-config';
import type { ImageInput } from '../types';

import '../styles/global.css';

export type Props = {
    title?: string;
    description?: string;
    image?: ImageInput | undefined;
    pageType?: 'website' | 'article';
    /** schema.org type for the page itself; omitted means only Person + WebSite are emitted. */
    schemaType?: 'BlogPosting' | 'CreativeWork';
    publishedAt?: Date;
    updatedAt?: Date;
    keywords?: string[];
    /** Trail from the home page to this one; the last entry is the current page. */
    breadcrumbs?: { label: string; href?: string }[];
};

const { description = '', pageType = 'website', schemaType, publishedAt, updatedAt, keywords, breadcrumbs } = Astro.props;
const pageTitle = Astro.props.title;
const title = [pageTitle, siteConfig.title].filter(Boolean).join(' | ');
const image = Astro.props.image ?? siteConfig.image;
// A string src is a file we ship ourselves, so its size is known up front; an
// imported asset is left to the image service, which may resize it.
const imageIsSiteCard = typeof image?.src === 'string';
let resolvedImage: { src: string; alt?: string } | undefined;
if (image?.src) {
    if (typeof image.src === 'string') {
        resolvedImage = {
            src: new URL(image.src, Astro.site).toString(),
            alt: image.alt
        };
    } else {
        const optimizedImage = await getImage({
            src: image.src as ImageMetadata,
            width: 1200,
            height: 627,
            format: 'jpeg',
            fit: 'cover'
        });
        resolvedImage = {
            src: new URL(optimizedImage.src, Astro.site).toString(),
            alt: image.alt
        };
    }
}
const canonicalURL = new URL(Astro.request.url, Astro.site);

/**
 * Enforce some standard canonical URL formatting across the site.
 */
function formatCanonicalURL(url: string | URL) {
    const path = url.toString();
    const hasQueryParams = path.includes('?');
    // If there are query params, make sure the URL has no trailing slash
    if (hasQueryParams) {
        path.replace(/\/?$/, '');
    }
    // otherwise, canonical URL always has a trailing slash
    return path.replace(/\/?$/, hasQueryParams ? '' : '/');
}

const canonical = formatCanonicalURL(canonicalURL);
const origin = (Astro.site ?? new URL(siteConfig.website)).origin;
const personId = `${origin}/#person`;
const websiteId = `${origin}/#website`;

let personImage: string | undefined;
if (siteConfig.avatar?.src) {
    personImage =
        typeof siteConfig.avatar.src === 'string'
            ? new URL(siteConfig.avatar.src, Astro.site).toString()
            : new URL((await getImage({ src: siteConfig.avatar.src, width: 400, height: 400, format: 'jpeg', fit: 'cover' })).src, Astro.site).toString();
}

/**
 * One @graph per page: the person, the site, and — on content pages — the work
 * itself. Emitted as JSON-LD so crawlers get entities rather than only meta tags.
 */
const graph: Record<string, unknown>[] = [
    {
        '@type': 'Person',
        '@id': personId,
        name: siteConfig.title,
        url: `${origin}/`,
        description: siteConfig.description,
        jobTitle: 'AI Engineer',
        ...(personImage ? { image: personImage } : {}),
        sameAs: siteConfig.socialLinks?.map((link) => link.href) ?? []
    },
    {
        '@type': 'WebSite',
        '@id': websiteId,
        url: `${origin}/`,
        name: siteConfig.title,
        description: siteConfig.description,
        inLanguage: 'en',
        publisher: { '@id': personId }
    }
];

if (breadcrumbs?.length) {
    graph.push({
        '@type': 'BreadcrumbList',
        '@id': `${canonical}#breadcrumb`,
        itemListElement: breadcrumbs.map((crumb, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: crumb.label,
            ...(crumb.href ? { item: new URL(crumb.href, origin).toString() } : {})
        }))
    });
}

if (schemaType) {
    const modified = updatedAt ?? publishedAt;
    // Content dates carry no time of day; emit date-only so a build in another
    // timezone cannot shift the calendar day.
    const isoDate = (date: Date) => date.toISOString().slice(0, 10);
    graph.push({
        '@type': schemaType,
        '@id': `${canonical}#${schemaType === 'BlogPosting' ? 'article' : 'work'}`,
        isPartOf: { '@id': websiteId },
        mainEntityOfPage: { '@id': canonical },
        url: canonical,
        ...(schemaType === 'BlogPosting' ? { headline: pageTitle ?? title } : { name: pageTitle ?? title }),
        ...(description ? { description } : {}),
        ...(resolvedImage?.src ? { image: [resolvedImage.src] } : {}),
        ...(publishedAt ? { datePublished: isoDate(publishedAt) } : {}),
        ...(modified ? { dateModified: isoDate(modified) } : {}),
        author: { '@id': personId },
        publisher: { '@id': personId },
        ...(keywords?.length ? { keywords: keywords.join(', ') } : {}),
        inLanguage: 'en'
    });
}

// `\u003c` keeps a literal `</script>` inside post text from closing the tag early.
const structuredData = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<!-- High Priority Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="generator" content={Astro.generator} />

<!-- Fonts -->
<link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin="anonymous" />
<link rel="preload" as="font" type="font/woff2" href={newsreaderWoff2} crossorigin="anonymous" />

<!-- Low Priority Global Metadata -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" href="/rss.xml" title="RSS" />

<!-- Page Metadata -->
<link rel="canonical" href={canonical} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={pageType} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
{resolvedImage?.src && <meta property="og:image" content={resolvedImage.src} />}
{resolvedImage?.src && imageIsSiteCard && <meta property="og:image:width" content="1200" />}
{resolvedImage?.src && imageIsSiteCard && <meta property="og:image:height" content="627" />}
{resolvedImage?.src && imageIsSiteCard && <meta property="og:image:type" content="image/jpeg" />}
{resolvedImage?.alt && <meta property="og:image:alt" content={resolvedImage.alt} />}

<!-- X/Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{resolvedImage?.src && <meta name="twitter:image" content={resolvedImage.src} />}
{resolvedImage?.alt && <meta name="twitter:image:alt" content={resolvedImage.alt} />}

<!-- Structured data: Person + WebSite everywhere, the work itself on content pages -->
<script type="application/ld+json" is:inline set:html={structuredData} />

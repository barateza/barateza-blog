---
type Props = { date: Date };

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
    {
        date.toLocaleDateString('en-us', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            // Format in UTC so the rendered date does not depend on the build
            // machine's timezone. Astro 7 hands this component different instants
            // for the same entry (tag pages get UTC midnight, other pages local
            // midnight), so a fixed timezone is required for consistent output.
            timeZone: 'UTC'
        })
    }
</time>
